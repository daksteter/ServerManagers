<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>ServerManagerTool</RootNamespace>
    <AssemblyName>JVH Ark Ascended Server Manager</AssemblyName>
    <StartupObject>ServerManagerTool.App</StartupObject>
    <ApplicationIcon>Art\favicon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <!-- Carried over from the .NET Framework App.config <runtime> section. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.CpuGroup" Value="true" />
    <RuntimeHostConfigurationOption Include="System.Threading.Thread.UseAllCpuGroups" Value="true" />
  </ItemGroup>

  <!-- Language packs and themes are loose XAML loaded from disk at runtime, not compiled pages. -->
  <ItemGroup>
    <Page Remove="Globalization\**;Styles\**" />
    <None Remove="Globalization\**;Styles\**;GameData\**;Art\**;NLog.config" />
    <Content Include="Globalization\**\*.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Styles\*.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="GameData\*.gamedata" CopyToOutputDirectory="Always" />
    <Content Include="NLog.config" CopyToOutputDirectory="Always" />
    <Resource Include="Art\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Config.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Config.settings</DependentUpon>
    </Compile>
    <None Update="Config.settings">
      <Generator>PublicSettingsSingleFileGenerator</Generator>
      <LastGenOutput>Config.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="NLog" Version="5.0.1" />
    <PackageReference Include="ProDotNetZip" Version="1.20.0" />
    <PackageReference Include="TaskScheduler" Version="2.10.1" />
    <PackageReference Include="TinyCsvParser" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArkData\ArkData.csproj" />
    <ProjectReference Include="..\ARKServerManager.Common\ARKServerManager.Common.csproj" />
    <ProjectReference Include="..\NeXtVdf\NeXt.Vdf.csproj" />
    <ProjectReference Include="..\Plugin.Common\Plugin.Common.csproj" />
    <ProjectReference Include="..\QueryMaster\QueryMaster.csproj" />
    <ProjectReference Include="..\ServerManager.Common\ServerManager.Common.csproj" />
    <ProjectReference Include="..\ServerManager.Discord\ServerManager.Discord.csproj" />
    <ProjectReference Include="..\ServerManager.Updater\ServerManager.Updater.csproj" />
    <ProjectReference Include="..\WPFSharp.Globalizer\WPFSharp.Globalizer.csproj" />
  </ItemGroup>
</Project>
