    <sys:String x:Key="ServerSettings_GBUsageToForceRestartUnits">GB</sys:String>
    <sys:String x:Key="ServerSettings_NoWildBabiesLabel">No wild babies</sys:String>
    <sys:String x:Key="ServerSettings_NoWildBabiesTooltip">Wild creatures never spawn as babies (-NoWildBabies).</sys:String>
    <sys:String x:Key="ServerSettings_DisableDinoNetRangeScalingLabel">Disable creature network range scaling</sys:String>
    <sys:String x:Key="ServerSettings_DisableDinoNetRangeScalingTooltip">Turns off the optimization that shrinks how far away players receive creature updates when many players are online. Costs performance on busy servers (-disabledinonetrangescaling).</sys:String>
    <sys:String x:Key="ServerSettings_DisableCustomCosmeticsLabel">Disable custom cosmetics</sys:String>
    <sys:String x:Key="ServerSettings_DisableCustomCosmeticsTooltip">Turns off custom cosmetic mods (skin-only mods that players' games download automatically) (-DisableCustomCosmetics).</sys:String>
    <sys:String x:Key="ServerSettings_DoCustomCosmeticValidationLabel">Validate custom cosmetics</sys:String>
    <sys:String x:Key="ServerSettings_DoCustomCosmeticValidationTooltip">Only allows custom cosmetic mods that pass validation. Use with the cosmetic whitelist URL (-DoCustomCosmeticValidation).</sys:String>
    <sys:String x:Key="ServerSettings_AlwaysTickDedicatedSkeletalMeshesLabel">Always animate idle creatures on the server</sys:String>
    <sys:String x:Key="ServerSettings_AlwaysTickDedicatedSkeletalMeshesTooltip">Turns off the low-FPS optimization that stops animating idle creatures on the server. Fixes collisions with idle creatures being off (for example when standing on a resting Brontosaurus), at some performance cost (-AlwaysTickDedicatedSkeletalMeshes).</sys:String>
    <sys:String x:Key="ServerSettings_GBUsageToForceRestartLabel">Restart when memory use reaches</sys:String>
    <sys:String x:Key="ServerSettings_GBUsageToForceRestartTooltip">When the server's memory use reaches this many GB, it saves the world and restarts to avoid a crash or rollback. Unchecked uses the server default (35 GB); 0 turns the protection off (-GBUsageToForceRestart).</sys:String>
    <sys:String x:Key="ServerSettings_CosmeticWhitelistOverrideLabel">Cosmetic whitelist URL:</sys:String>
    <sys:String x:Key="ServerSettings_CosmeticWhitelistOverrideTooltip">URL of the list of allowed custom cosmetic mods, comma-separated entries in the form ModID|DynamicDownload (0/1)|AllowNonDataOnlyBlueprints (0/1). Leave empty for none (CosmeticWhitelistOverride).</sys:String>
    <sys:String x:Key="ServerSettings_AdminListURLLabel">Admin list URL:</sys:String>
    <sys:String x:Key="ServerSettings_AdminListURLTooltip">URL of a list of admin player IDs, as an alternative to AllowedCheaterAccountIDs.txt (handy for sharing admins across a cluster). The server checks it for changes every 10 minutes. Leave empty for none (AdminListURL).</sys:String>
    <sys:String x:Key="ServerSettings_PassiveModIdsLabel">Passive mod IDs:</sys:String>
    <sys:String x:Key="ServerSettings_PassiveModIdsTooltip">CurseForge mod IDs whose data is loaded but whose content is turned off, for example to keep a cluster's modded creatures transferable on maps where they shouldn't spawn. The server downloads these too; they don't also need to be in Mod IDs (passed as -passivemods=).</sys:String>
    <sys:String x:Key="ServerSettings_EditModListTooltip">Edit the mod list: add, remove and reorder mods, open their CurseForge pages, and see the names of the mods the server has downloaded.</sys:String>
    <sys:String x:Key="ServerSettings_EditPassiveModListTooltip">Edit the passive mod list: add, remove and reorder mods, open their CurseForge pages, and see the names of the mods the server has downloaded.</sys:String>
    <sys:String x:Key="ServerSettings_AllowCryoFridgeOnSaddleLabel">Allow cryofridges on saddles and rafts</sys:String>
    <sys:String x:Key="ServerSettings_AllowCryoFridgeOnSaddleTooltip">Cryofridges can be built on platform saddles and rafts (AllowCryoFridgeOnSaddle).</sys:String>
    <sys:String x:Key="ServerSettings_DisableCryopodEnemyCheckLabel">Allow cryopods near enemies</sys:String>
    <sys:String x:Key="ServerSettings_DisableCryopodEnemyCheckTooltip">Cryopods can be used while enemies are nearby (DisableCryopodEnemyCheck).</sys:String>
    <sys:String x:Key="ServerSettings_DisableCryopodFridgeRequirementLabel">Allow cryopods without a cryofridge</sys:String>
    <sys:String x:Key="ServerSettings_DisableCryopodFridgeRequirementTooltip">Cryopods can be used without a powered cryofridge in range (DisableCryopodFridgeRequirement).</sys:String>
    <sys:String x:Key="ServerSettings_CryoHospitalHoursToRegenHPLabel">Hours to regenerate health</sys:String>
    <sys:String x:Key="ServerSettings_CryoHospitalHoursToRegenHPTooltip">How many hours a creature in the Cryo Hospital takes to regenerate its health (CryoHospitalHoursToRegenHP).</sys:String>
    <sys:String x:Key="ServerSettings_CryoHospitalHoursToRegenFoodLabel">Hours to refill food</sys:String>
    <sys:String x:Key="ServerSettings_CryoHospitalHoursToRegenFoodTooltip">How many hours a creature in the Cryo Hospital takes to refill its food (CryoHospitalHoursToRegenFood).</sys:String>
    <sys:String x:Key="ServerSettings_CryoHospitalHoursToDrainTorporLabel">Hours to drain torpor</sys:String>
    <sys:String x:Key="ServerSettings_CryoHospitalHoursToDrainTorporTooltip">How many hours a creature in the Cryo Hospital takes to lose its torpor (CryoHospitalHoursToDrainTorpor).</sys:String>
    <sys:String x:Key="ServerSettings_CryoHospitalMatingCooldownReductionLabel">Mating cooldown speed</sys:String>
    <sys:String x:Key="ServerSettings_CryoHospitalMatingCooldownReductionTooltip">How much faster a creature's mating cooldown passes while it's in the Cryo Hospital (CryoHospitalMatingCooldownReduction).</sys:String>
    <sys:String x:Key="ServerSettings_MaxActiveOutpostsLabel">Maximum active outposts</sys:String>
    <sys:String x:Key="ServerSettings_MaxActiveOutpostsTooltip">How many outposts can be active at once. Unchecked uses the game's default (MaxActiveOutposts).</sys:String>
    <sys:String x:Key="ServerSettings_MaxActiveResourceCachesLabel">Maximum active resource caches</sys:String>
    <sys:String x:Key="ServerSettings_MaxActiveResourceCachesTooltip">How many resource caches can be active at once. Unchecked uses the game's default (MaxActiveResourceCaches).</sys:String>
    <sys:String x:Key="ServerSettings_MaxActiveCityOutpostsLabel">Maximum active city outposts</sys:String>
