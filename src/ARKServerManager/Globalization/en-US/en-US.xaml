    <sys:String x:Key="ServerSettings_OutpostSigilRewardMultiplierLabel">Outpost sigil rewards</sys:String>
    <sys:String x:Key="ServerSettings_OutpostSigilRewardMultiplierTooltip">Scales the sigils rewarded by outpost missions; higher gives more (OutpostSigilRewardMultiplier).</sys:String>
    <sys:String x:Key="ServerSettings_DisablePhotoModeLabel">Disable photo mode</sys:String>
    <sys:String x:Key="ServerSettings_DisablePhotoModeTooltip">Players can't use photo mode (bDisablePhotoMode).</sys:String>
    <sys:String x:Key="ServerSettings_PhotoModeRangeLimitLabel">Photo mode camera range</sys:String>
    <sys:String x:Key="ServerSettings_PhotoModeRangeLimitTooltip">How far the photo mode camera can move from the player, in Unreal units (PhotoModeRangeLimit).</sys:String>
    <sys:String x:Key="ServerSettings_IgnorePVPMountedWeaponryRestrictionsLabel">Allow weapons while riding (PvP)</sys:String>
    <sys:String x:Key="ServerSettings_IgnorePVPMountedWeaponryRestrictionsTooltip">On PvP servers, players riding a Rhyniognatha, Megalania, Rock Drake or Ravager can use weapons (IgnorePVPMountedWeaponryRestrictions).</sys:String>
    <sys:String x:Key="ServerSettings_ImplantSuicideCDLabel">Implant respawn cooldown</sys:String>
